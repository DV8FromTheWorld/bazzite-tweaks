# Enable wake from sleep for game controller dongles.
# Modeled on /usr/lib/udev/rules.d/99-steamcontroller-wakeup.rules

# Xbox 360 Wireless Receiver
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="045e", ATTR{idProduct}=="0719", ATTR{power/wakeup}="enabled"

# DS5Dongle (Pico 2 W) - DualSense / DualSense Edge persona
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="054c", ATTR{idProduct}=="0ce6", ATTR{power/wakeup}="enabled"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="054c", ATTR{idProduct}=="0df2", ATTR{power/wakeup}="enabled"

# DS4Dongle (Pico 2 W) - wired DualShock 4 v2 persona
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="054c", ATTR{idProduct}=="09cc", ATTR{power/wakeup}="enabled"
